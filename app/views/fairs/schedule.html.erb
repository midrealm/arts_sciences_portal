<div class="schedule-page">
  <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-4">
    <div>
      <h1 class="h2 mb-2">Schedule: <%= @fair.name %></h1>
      <p class="text-secondary schedule-lead mb-0">
        Choose a timeslot and room for each entry, then assign volunteer scorers. Save when you are done editing.
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2 schedule-toolbar">
      <%= button_to "Auto-schedule (preview)", auto_schedule_fair_path(@fair), method: :post, class: "btn btn-outline-success" %>
      <%= link_to "Review schedule", view_schedule_fair_path(@fair), class: "btn btn-outline-primary" %>
      <%= link_to "Back to fairs", fairs_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if @auto_schedule_preview %>
    <div class="alert alert-warning">
      Showing an auto-generated schedule preview. Nothing has been saved yet — review the suggestions and click <strong>Save schedule</strong> to persist.
    </div>

    <% unassigned_entries = schedule_unassigned_entries(@entries, @proposed_schedule, @auto_schedule_preview) %>
    <% if unassigned_entries.any? %>
      <div class="alert alert-danger schedule-manual-banner">
        <strong><%= pluralize(unassigned_entries.size, "entry") %> could not be auto-scheduled</strong>
        and will need manual assignment:
        <%= unassigned_entries.map(&:entry_name).join(", ") %>.
      </div>
    <% end %>
  <% end %>

  <% if @entries.empty? %>
    <div class="alert alert-info mb-0">There are no entries for this fair yet.</div>
  <% else %>
    <%= form_for :entries, url: schedule_fair_path(@fair), html: { class: "schedule-form" } do %>
      <% @entries.each do |entry| %>
        <% needs_manual = schedule_needs_manual_assignment?(entry, @proposed_schedule, @auto_schedule_preview) %>
        <div class="card border-0 shadow-sm mb-4 schedule-entry-card<%= " schedule-entry-card--manual" if needs_manual %>">
          <div class="card-header schedule-entry-header d-flex flex-wrap justify-content-between align-items-start gap-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
              <% if needs_manual %>
                <span class="badge text-bg-danger">Needs manual assignment</span>
              <% end %>
              <span class="badge text-bg-secondary schedule-pent-badge"><%= entry.pent_or_div %></span>
              <%= link_to entry.entry_name, entry_path(entry), target: "_blank", rel: "noopener", class: "fw-semibold schedule-entry-title" %>
            </div>
            <div class="small text-secondary schedule-entrant">
              <div><%= entry.entrant_string %></div>
              <% if entry.preferences.any? %>
                <div>
                  <span class="fw-semibold">Entry preferences:</span>
                  <%= entry.preferences.map(&:name).join(", ") %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="card-body">
            <% if needs_manual %>
              <div class="alert alert-danger py-2 mb-3 schedule-entry-manual-alert">
                Auto-schedule could not place this entry. Choose a timeslot, room, and scorers manually.
              </div>
            <% end %>
            <%= fields_for "entries[]", entry do |f| %>
              <div class="row g-4">
                <div class="col-12">
                  <fieldset class="mb-0">
                    <legend class="form-label fw-semibold mb-3">Timeslot</legend>
                    <div class="row g-2">
                      <% @timeslots.each do |timeslot| %>
                        <% input_id = "entry_#{entry.id}_timeslot_#{timeslot.id}" %>
                        <div class="col-6 col-md-4 col-xl-3">
                          <div class="schedule-slot-option border rounded p-2 h-100">
                            <div class="form-check mb-0">
                              <%= f.radio_button :timeslot_id, timeslot.id,
                                checked: schedule_timeslot_id(entry, @proposed_schedule, @auto_schedule_preview) == timeslot.id,
                                class: "form-check-input",
                                id: input_id %>
                              <%= label_tag input_id, timeslot.description, class: "form-check-label small" %>
                            </div>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </fieldset>
                </div>

                <div class="col-12 col-md-6 col-xl-4">
                  <%= f.label :location_id, "Room", class: "form-label fw-semibold" %>
                  <%= f.select :location_id,
                    Location.for_fair(entry.fair).map { |m| [m.description, m.id] },
                    { selected: schedule_location_id(entry, @proposed_schedule, @auto_schedule_preview) },
                    class: "form-select" %>
                </div>
              </div>
            <% end %>

            <div class="mt-4 pt-3 border-top">
              <h2 class="h6 fw-semibold mb-2">Scorers</h2>
              <p class="small text-secondary mb-3">
                Checked scorers are assigned to this entry. Hover a scorer cell to see scoring preferences.
              </p>
              <% if @judges.any? %>
                <div class="row g-2">
                  <% order_by_preference(@judges, entry).each do |user| %>
                    <% cid = "judge_assign_#{entry.id}_#{user.id}" %>
                    <% prefs_id = "judge-prefs-#{user.id}" %>
                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                      <div
                        class="schedule-judge-check border rounded px-2 py-2 h-100"
                        data-judge-prefs="<%= prefs_id %>"
                        data-bs-title="<%= user.email_or_name %>"
                        tabindex="0"
                        aria-label="<%= "Scorer #{user.email_or_name}. Hover for scoring preferences." %>">
                        <div class="form-check mb-0">
                          <%= check_box_tag "judge_assigns[]", "#{entry.id}_#{user.id}",
                            schedule_judge_assigned?(entry, user, @proposed_schedule, @auto_schedule_preview),
                            id: cid, class: "form-check-input" %>
                          <label class="form-check-label small w-100 mb-0" for="<%= cid %>">
                            <%= user.email_or_name %>
                            <span class="text-muted"><%= user.display_peerages %></span>
                          </label>
                        </div>
                        <div id="<%= prefs_id %>" class="d-none schedule-judge-prefs-source">
                          <%= judge_preferences_popover_body(user) %>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <p class="text-secondary small mb-0">No volunteers have signed up to score this fair yet.</p>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="card border-primary schedule-save-card shadow-sm">
        <div class="card-body d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center justify-content-between gap-3">
          <p class="small text-secondary mb-0">
            <strong>Save schedule</strong> stores timeslots, rooms, and scorer assignments for every entry above.
          </p>
          <%= submit_tag "Save schedule", class: "btn btn-primary btn-lg px-4 flex-shrink-0" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<script>
  (function () {
    function initScheduleJudgePopovers() {
      if (typeof bootstrap === "undefined") return;

      document.querySelectorAll(".schedule-judge-check[data-judge-prefs]").forEach(function (el) {
        var existing = bootstrap.Popover.getInstance(el);
        if (existing) existing.dispose();

        var contentEl = document.getElementById(el.dataset.judgePrefs);
        if (!contentEl) return;

        new bootstrap.Popover(el, {
          trigger: "hover focus",
          html: true,
          sanitize: false,
          placement: "auto",
          container: "body",
          customClass: "schedule-judge-prefs-popover",
          title: el.dataset.bsTitle || "",
          content: contentEl.innerHTML
        });
      });
    }

    document.addEventListener("turbolinks:load", initScheduleJudgePopovers);
    document.addEventListener("DOMContentLoaded", initScheduleJudgePopovers);
  })();
</script>
