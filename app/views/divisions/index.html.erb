<br><%= link_to 'Back', root_path %>
<br>
<h1>Divisions</h1>

<%= render partial: "layouts/deprecated_toggle",
           locals: {
             active_url: divisions_path,
             deprecated_url: divisions_path(show_deprecated: true),
             show_deprecated: @show_deprecated
           } %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @divisions.each do |division| %>
      <tr>
        <td><%= division.name %></td>
        <td><%= division.description %></td>
        <td><%= link_to 'Show', division %></td>
        <td><%= link_to 'Edit', edit_division_path(division) %></td>
        <td><%= button_to 'Destroy', division, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to 'New Division', new_division_path %>
<br><%= link_to 'Back', root_path %>
