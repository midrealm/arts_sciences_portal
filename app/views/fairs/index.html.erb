<%= link_to "Back", root_path, class: "btn btn-outline-secondary btn-sm mb-3" %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3 mb-4">
  <h1 class="h2 mb-0">Fairs</h1>
  <%= link_to "New fair", new_fair_path, class: "btn btn-primary" %>
</div>

<div class="table-responsive fairs-index-scroll shadow-sm rounded">
  <table class="mb-0 fairs-index-table align-middle">
    <thead>
      <tr>
        <th scope="col" class="fair-name-col">Name</th>
        <th scope="col">Date</th>
        <th scope="col">Region</th>
        <th scope="col" class="text-center" title="Internet access for electronic judging">Internet</th>
        <th scope="col" class="text-center" title="Entries allowed">Entries Allowed</th>
        <th scope="col" class="text-center" title="Scheduling visible">Scheduling Visible</th>
        <th scope="col" class="text-center" title="Mail-in scoresheets allowed">Mail-in Scoresheets Allowed</th>
        <th scope="col" class="text-center" title="Scoresheets allowed">Scoresheet Submission Allowed</th>
        <th scope="col" class="text-center" title="Finalized">Finalized</th>
      </tr>
    </thead>

    <tbody>
      <% @fairs.each do |fair| %>
        <tr class="fairs-index-data-row">
          <td class="fair-name-col fw-medium"><%= fair.name %></td>
          <td class="text-nowrap"><%= fair.date %></td>
          <td class="text-nowrap"><%= fair.region.name %></td>
          <td class="text-center"><%= yes_no_badge(fair.internet_access) %></td>
          <td class="text-center"><%= yes_no_badge(fair.entries_allowed) %></td>
          <td class="text-center"><%= yes_no_badge(fair.scheduling_visible) %></td>
          <td class="text-center"><%= yes_no_badge(fair.mail_in_scoresheets_allowed) %></td>
          <td class="text-center"><%= yes_no_badge(fair.scoresheets_allowed) %></td>
          <td class="text-center"><%= yes_no_badge(fair.finalized) %></td>
        </tr>
        <tr class="fairs-index-actions-row">
          <td colspan="10">
            <div class="fairs-index-actions d-flex flex-wrap align-items-center gap-2">
              <%= link_to "View Schedule", view_schedule_fair_path(fair), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Manage Schedule", schedule_fair_path(fair), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Assign Judges", fair_judge_assigns_path(fair), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to "Final Review", review_fair_path(fair), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Show Details", fair, class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Edit Details", edit_fair_path(fair), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to "Tallyroom", tallyroom_fair_path(fair), class: "btn btn-sm btn-outline-secondary" %>
              <%= button_to "Delete",
                fair,
                method: :delete,
                class: "btn btn-sm btn-outline-danger",
                form: { class: "d-inline" },
                data: { confirm: "Are you sure?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<p class="small text-secondary mt-2 mb-0 fairs-index-scroll-hint">
  Scroll horizontally on smaller screens if needed.
</p>

<div class="mt-4">
  <%= link_to "Back", root_path, class: "btn btn-outline-secondary btn-sm" %>
</div>
